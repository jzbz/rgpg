// Structs shared with Rust. Everything here is pre-formatted by rgpg-gui's
// `to_row` helpers: the UI never parses or formats a value itself.

export struct CertRow {
    fingerprint: string,
    fingerprint-pretty: string,
    key-id: string,
    primary-user-id: string,
    name: string,
    email: string,
    user-ids: string,
    algorithm: string,
    created: string,
    expires: string,
    validity: string,
    capabilities: string,
    has-secret: bool,
    initials: string,
    // Index into Theme.monograms, derived from the fingerprint so a colour
    // stays with a certificate across sessions and across light/dark.
    tint-index: int,
}

export struct RecipientRow {
    fingerprint: string,
    label: string,
    sublabel: string,
    initials: string,
    tint-index: int,
    selected: bool,
}

export struct SignatureRow {
    good: bool,
    signer: string,
    detail: string,
}
