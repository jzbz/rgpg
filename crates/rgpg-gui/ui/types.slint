// Structs shared with Rust. Everything here is pre-formatted by rgpg-gui's
// `to_row` helpers: the UI never parses or formats a value itself.

export struct CertRow {
    fingerprint: string,
    fingerprint-pretty: string,
    key-id: string,
    primary-user-id: string,
    name: string,
    email: string,
    user-ids: string,
    algorithm: string,
    created: string,
    expires: string,
    validity: string,
    capabilities: string,
    has-secret: bool,
    initials: string,
    // Index into Theme.monograms, derived from the fingerprint so a colour
    // stays with a certificate across sessions and across light/dark.
    tint-index: int,
    // Web-of-trust result: "verified", "partly verified" or "unverified".
    // Separate from `validity`, which is only about the certificate being
    // internally sound.
    authentication: string,
    is-trust-root: bool,
    // Why the certificate was revoked; empty when it has not been.
    revocation: string,
}

// One certification already on a certificate, flattened for display.
export struct CertificationRow {
    certifier: string,
    user-id: string,
    // "full · publishable · 2026-08-10", or why it could not be checked.
    detail: string,
    good: bool,
    by-me: bool,
    // This entry withdraws an earlier certification.
    is-revocation: bool,
}

// A user ID offered for certification, with its tick state.
export struct UserIdRow {
    text: string,
    selected: bool,
}

export struct RecipientRow {
    fingerprint: string,
    label: string,
    sublabel: string,
    initials: string,
    tint-index: int,
    selected: bool,
}

export struct SignatureRow {
    good: bool,
    signer: string,
    detail: string,
}
